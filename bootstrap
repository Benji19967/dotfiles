#!/usr/bin/env bash
# One-shot setup for any machine (macOS, Ubuntu, RHEL/CentOS). No sudo needed.
#
#   ./bootstrap                    # tools, data and caches under $HOME
#   ./bootstrap --root /nfs/me     # small $HOME: put everything heavy under /nfs/me
#   ./bootstrap -- --only dotfiles # anything after -- goes to `mise bootstrap`
#
# Only what must happen before mise starts lives here: write DOT_ROOT, load
# the env that relocates MISE_DATA_DIR (mise reads it only from the process
# env, not from config), install mise. Everything else (backups, dotfiles,
# tools, nvim plugins) is declared in ./mise.toml. Safe to re-run.
set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT=""
MISE_ARGS=()

usage() { sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --root) ROOT="${2:?--root needs a directory}"; shift 2 ;;
    --root=*) ROOT="${1#*=}"; shift ;;
    -h|--help) usage 0 ;;
    --) shift; MISE_ARGS=("$@"); break ;;
    *) echo "unknown argument: $1" >&2; usage 1 ;;
  esac
done

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

# --- machine-local env -------------------------------------------------------
# ~/.dotfiles.env is untracked and read first by ~/.config/shell/10_env.sh.

ENV_FILE="$HOME/.dotfiles.env"
if [ -n "$ROOT" ]; then
  mkdir -p "$ROOT"
  ROOT="$(cd "$ROOT" && pwd)"
  tmp="$(mktemp)"
  if [ -f "$ENV_FILE" ]; then
    grep -v '^export DOT_ROOT=' "$ENV_FILE" > "$tmp" || true
  else
    printf '# Machine-local dotfiles settings (written by bootstrap, not tracked).\n' > "$tmp"
  fi
  printf 'export DOT_ROOT=%q\n' "$ROOT" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
fi

# The env the interactive shell will get, so tools land under DOT_ROOT on
# this very first run too.
set +u
# shellcheck source=shell-base/.config/shell/10_env.sh
. "$DOTFILES/shell-base/.config/shell/10_env.sh"
set -u
log "DOT_ROOT=$DOT_ROOT"

# --- mise --------------------------------------------------------------------
# The binary (~150MB) goes to $DOT_ROOT/.local/bin (= ~/.local/bin unless --root).

MISE_BIN_DIR="$DOT_ROOT/.local/bin"
mkdir -p "$HOME/.config" "$HOME/.local/bin" "$MISE_BIN_DIR"
export PATH="$MISE_BIN_DIR:$HOME/.local/bin:$PATH"

if ! command -v mise >/dev/null; then
  log "installing mise into $MISE_BIN_DIR"
  if command -v curl >/dev/null; then
    curl -fsSL https://mise.run | MISE_INSTALL_PATH="$MISE_BIN_DIR/mise" sh
  elif command -v wget >/dev/null; then
    wget -qO- https://mise.run | MISE_INSTALL_PATH="$MISE_BIN_DIR/mise" sh
  else
    die "need curl or wget to install mise"
  fi
fi
log "$(mise --version)"

cd "$DOTFILES"
mise trust "$DOTFILES/mise.toml" >/dev/null
exec mise bootstrap --yes ${MISE_ARGS[@]+"${MISE_ARGS[@]}"}
