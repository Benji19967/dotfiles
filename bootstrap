#!/usr/bin/env bash
# One-shot setup for any machine (macOS, Ubuntu, RHEL/CentOS). No sudo needed.
#
#   ./bootstrap                    # tools, data and caches under $HOME
#   ./bootstrap --root /nfs/me     # small $HOME: put everything heavy under /nfs/me
#   ./bootstrap -- --only dotfiles # anything after -- goes to `mise bootstrap`
#
# What it does: write DOT_ROOT (if --root) -> install mise if missing -> back up
# real files that a dotfile symlink would replace -> `mise bootstrap` with
# ./mise.toml (dotfiles) + mise-global/config.toml (tools).
# Safe to re-run.
set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT=""
MISE_ARGS=()

usage() { sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --root) ROOT="${2:?--root needs a directory}"; shift 2 ;;
    --root=*) ROOT="${1#*=}"; shift ;;
    -h|--help) usage 0 ;;
    --) shift; MISE_ARGS=("$@"); break ;;
    *) echo "unknown argument: $1" >&2; usage 1 ;;
  esac
done

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

# --- 1. machine-local env ----------------------------------------------------
# ~/.dotfiles.env is untracked and read first by ~/.config/shell/10_env.sh.

ENV_FILE="$HOME/.dotfiles.env"
if [ -n "$ROOT" ]; then
  mkdir -p "$ROOT"
  ROOT="$(cd "$ROOT" && pwd)"
  log "DOT_ROOT=$ROOT (written to $ENV_FILE)"
  tmp="$(mktemp)"
  if [ -f "$ENV_FILE" ]; then
    grep -v '^export DOT_ROOT=' "$ENV_FILE" > "$tmp" || true
  else
    printf '# Machine-local dotfiles settings (written by bootstrap, not tracked).\n' > "$tmp"
  fi
  printf 'export DOT_ROOT=%q\n' "$ROOT" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
fi

# Load exactly the env the interactive shell will get (MISE_DATA_DIR etc.),
# so tools land under DOT_ROOT on this very first run too.
set +u
# shellcheck source=shell-base/.config/shell/10_env.sh
. "$DOTFILES/shell-base/.config/shell/10_env.sh"
set -u
log "DOT_ROOT=$DOT_ROOT"

MISE_BIN_DIR="$DOT_ROOT/.local/bin"   # = ~/.local/bin unless --root
mkdir -p "$HOME/.config" "$HOME/.local/bin" "$MISE_BIN_DIR"
export PATH="$MISE_BIN_DIR:$HOME/.local/bin:$PATH"

# --- 2. mise -----------------------------------------------------------------
# The binary (~150MB) goes to $DOT_ROOT/.local/bin; everything it installs
# goes to $MISE_DATA_DIR.

if ! command -v mise >/dev/null; then
  log "installing mise into $MISE_BIN_DIR"
  if command -v curl >/dev/null; then
    curl -fsSL https://mise.run | MISE_INSTALL_PATH="$MISE_BIN_DIR/mise" sh
  elif command -v wget >/dev/null; then
    wget -qO- https://mise.run | MISE_INSTALL_PATH="$MISE_BIN_DIR/mise" sh
  else
    die "need curl or wget to install mise"
  fi
fi
log "$(mise --version)"

cd "$DOTFILES"
mise trust "$DOTFILES/mise.toml" >/dev/null

# --- 3. back up real files in the way ----------------------------------------
# mise refuses to replace a real file with a symlink (or replaces it without a
# copy, with --force-dotfiles). Move such files aside instead.

BACKUP="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
while IFS= read -r target; do
  path="${target/#\~/$HOME}"
  [ -L "$path" ] && continue           # a symlink: mise replaces it itself
  [ -e "$path" ] || continue
  rel="${path#"$HOME"/}"
  mkdir -p "$BACKUP/$(dirname "$rel")"
  mv "$path" "$BACKUP/$rel"
  warn "backed up $path -> $BACKUP/$rel"
done < <(mise dotfiles diff 2>/dev/null | sed -n 's/^  current: \(.*\) exists$/\1/p')

# --- 4. apply ----------------------------------------------------------------
# Dotfiles first (incl. ~/.config/mise/config.toml), then mise re-reads its
# config and installs the global [tools].

log "mise bootstrap"
mise bootstrap --yes ${MISE_ARGS[@]+"${MISE_ARGS[@]}"}

cat <<EOF

Done. Open a new shell (or: exec \$SHELL -l), then optionally:

  nvim --headless "+Lazy! sync" +qa      # nvim plugins into \$XDG_DATA_HOME
  uv python install 3.12                 # python, replaces pyenv
  mise use -g rust                       # rust toolchain (into \$MISE_DATA_DIR)

EOF
